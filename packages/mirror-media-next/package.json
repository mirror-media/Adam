    "codegen:check": "pnpm codegen && node scripts/check-codegen-clean.mjs",
    "check:no-new-js": "node scripts/check-no-new-js.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "start-amp-proxy-server": "node amp-proxy-server"
