{
  "name": "mirror-media-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"node mocks/server\" \"next dev\"",
    "build": "pnpm build:sw && next build",
    "build:sw": "node scripts/build-sw.js",
    "analyze": "ANALYZE=true next build --no-lint",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
